{
  "name": "reve-commun",
  "version": "1.0.0",
  "description": "Plateforme de connexion des bâtisseurs d'un nouveau monde",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node --watch server/index.js",
    "client": "cd client && npm run dev",
    "db:init": "node scripts/init-db.js",
    "db:seed": "node scripts/seed-db.js",
    "simulate": "node simulation/scraper-simulator.js",
    "install:all": "npm install && cd client && npm install"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  }
}
